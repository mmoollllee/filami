# Keep dev-only scaffolding out of the Composer `--prefer-dist` archive so consuming
# apps don't pull the test suite, docs and build tooling into vendor/.
/tests            export-ignore
/docs             export-ignore
# stubs/ stays in the dist archive: it is copy-paste material for consumers.
phpunit.xml.dist  export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
